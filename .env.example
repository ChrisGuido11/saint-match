# Saint Match — Environment Variables
# Copy this file to .env and fill in your values

# ── Client-side (Expo) ──────────────────────────────────────────────────
# These are bundled into the app via Expo's env var system.

# Your Supabase project URL (found in Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (found in Settings > API)
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Server-side (Edge Function secrets) ─────────────────────────────────
# Set these via: supabase secrets set KEY=VALUE
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY are
# auto-provided by the Supabase runtime — no need to set them manually.

# Anthropic API key for Claude AI saint matching
# Set via: supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_API_KEY=sk-ant-...

# (Optional) Restrict CORS origins for the Edge Function
# Comma-separated list. Defaults to '*' if not set.
# For mobile apps, Origin headers may not be sent, so '*' is typical.
# ALLOWED_ORIGINS=https://your-app.com,https://your-staging.com

# ── RevenueCat (iOS In-App Purchases) ────────────────────────────────
# Public iOS API key from RevenueCat Dashboard > Project Settings > API Keys
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxx

# RevenueCat webhook auth secret (set as Edge Function secret)
# Set via: supabase secrets set REVENUECAT_WEBHOOK_SECRET=whsec_...
# REVENUECAT_WEBHOOK_SECRET=whsec_...

# ── Google AdMob (Android ads) ───────────────────────────────────────────
# See ADMOB_SETUP.md for the full setup + tuning guide.
#
# The AdMob *App ID* is configured natively in app.json (config plugin), NOT
# here — currently set to Google's sample/test App IDs. Replace those before a
# production build.
#
# Ad UNIT IDs below are runtime-selected: test IDs are used in dev automatically.
# Leave these unset to ship test ads (safe); set them to go live. iOS values are
# only needed if you later enable iOS ads.
# EXPO_PUBLIC_ADMOB_BANNER_ANDROID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
# EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
# EXPO_PUBLIC_ADMOB_REWARDED_ANDROID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
# EXPO_PUBLIC_ADMOB_APP_OPEN_ANDROID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
# EXPO_PUBLIC_ADMOB_BANNER_IOS=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
# EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
# EXPO_PUBLIC_ADMOB_REWARDED_IOS=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
# EXPO_PUBLIC_ADMOB_APP_OPEN_IOS=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx

# Platform enablement (defaults: Android on, iOS off). Master kill-switch too.
# EXPO_PUBLIC_ADS_ENABLED=true
# EXPO_PUBLIC_ADS_ENABLED_ANDROID=true
# EXPO_PUBLIC_ADS_ENABLED_IOS=false

# Frequency tuning (all optional — start aggressive, A/B upward).
# EXPO_PUBLIC_ADS_INTERSTITIAL_GAP_MS=30000
# EXPO_PUBLIC_ADS_APP_OPEN_COOLDOWN_MS=900000
# EXPO_PUBLIC_ADS_APP_OPEN_WARM_RESUME=true
# EXPO_PUBLIC_ADS_APP_OPEN_COLD_START=false
# EXPO_PUBLIC_ADS_BANNER_COLLAPSIBLE=bottom    # bottom | top | none

# Comma-separated device IDs allowed to receive real ads during QA (from logs).
# EXPO_PUBLIC_ADMOB_TEST_DEVICE_IDS=ABCDEF0123456789,...
